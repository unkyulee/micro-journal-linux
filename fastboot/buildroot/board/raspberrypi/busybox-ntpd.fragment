# One-shot NTP client only, used to sync the clock once WiFi connects
# (this board has no RTC, so time is wrong until then). No server mode,
# no /etc/ntp.conf parsing, no auth - just `ntpd -q -p <server>`.
CONFIG_NTPD=y
# CONFIG_FEATURE_NTPD_SERVER is not set
# CONFIG_FEATURE_NTPD_CONF is not set
# CONFIG_FEATURE_NTP_AUTH is not set
